<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.com/bpmn">
  <bpmn:process id="Process_Delegacja" name="Wniosek delegacyjny" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Pracownik składa wniosek" />
    <bpmn:userTask id="Task_Fill" name="Wypełnienie formularza" />
    <bpmn:userTask id="Task_Supervisor" name="Akceptacja przełożonego" />
    <bpmn:exclusiveGateway id="Gw_Supervisor" name="Decyzja?" />
    <bpmn:userTask id="Task_Finance" name="Akceptacja finansowa" />
    <bpmn:exclusiveGateway id="Gw_Finance" name="Decyzja?" />
    <bpmn:exclusiveGateway id="Gw_Cost" name="Koszt powyżej 5000 zł?" />
    <bpmn:userTask id="Task_Rector" name="Akceptacja prorektora" />
    <bpmn:exclusiveGateway id="Gw_Rector" name="Decyzja?" />
    <bpmn:serviceTask id="Task_Pdf" name="Wygenerowanie polecenia wyjazdu w PDF" />
    <bpmn:endEvent id="End_Approved" name="Wniosek zatwierdzony" />
    <bpmn:endEvent id="End_Rejected" name="Wniosek odrzucony" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Fill" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Fill" targetRef="Task_Supervisor" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Supervisor" targetRef="Gw_Supervisor" />
    <bpmn:sequenceFlow id="F4" name="zaakceptowany" sourceRef="Gw_Supervisor" targetRef="Task_Finance" />
    <bpmn:sequenceFlow id="F5" name="do poprawy" sourceRef="Gw_Supervisor" targetRef="Task_Fill" />
    <bpmn:sequenceFlow id="F6" name="odrzucony" sourceRef="Gw_Supervisor" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Finance" targetRef="Gw_Finance" />
    <bpmn:sequenceFlow id="F8" name="zaakceptowany" sourceRef="Gw_Finance" targetRef="Gw_Cost" />
    <bpmn:sequenceFlow id="F9" name="odrzucony" sourceRef="Gw_Finance" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F10" name="tak" sourceRef="Gw_Cost" targetRef="Task_Rector" />
    <bpmn:sequenceFlow id="F11" name="nie" sourceRef="Gw_Cost" targetRef="Task_Pdf" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Rector" targetRef="Gw_Rector" />
    <bpmn:sequenceFlow id="F13" name="zaakceptowany" sourceRef="Gw_Rector" targetRef="Task_Pdf" />
    <bpmn:sequenceFlow id="F14" name="odrzucony" sourceRef="Gw_Rector" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Pdf" targetRef="End_Approved" />
  </bpmn:process>
